<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (API 31+ uses data_extraction_rules.xml).
   User-imported sounds (filesDir/custom/) can be hundreds of MB, far over the
   25 MB backup quota, so they are excluded. Their index is excluded with them;
   SoundLibrary also drops any index entry whose files are missing.
-->
<full-backup-content>
    <exclude domain="file" path="custom/" />
    <exclude domain="file" path="custom_sounds.json" />
</full-backup-content>
