<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12+. See backup_rules.xml for why user-imported
   sounds are left out of cloud backup. Device-to-device transfer has no size
   quota, so imports do move to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="custom/" />
        <exclude domain="file" path="custom_sounds.json" />
    </cloud-backup>
</data-extraction-rules>
